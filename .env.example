# MySQL credentials for local Docker Compose
MYSQL_ROOT_PASSWORD=replace_with_local_root_password
MYSQL_APP_PASSWORD=replace_with_local_app_password

# Optional integrations
COHERE_API_KEY=
SLACK_WEBHOOK_URL=

# Frontend API configuration
# Docker Compose uses /api by default
# REACT_APP_API_BASE_URL=/api

# Grafana login for the optional monitoring overlay.
# Set a strong, unique value in your ignored local .env file.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_strong_grafana_password
